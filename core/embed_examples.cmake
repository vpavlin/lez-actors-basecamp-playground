# Turns examples/*.bin into a C++ source of byte arrays (lez_examples_data.cpp), so the guests ship
# inside the core library: no assets to locate at run time.
#   cmake -DSRC=<examples dir> -DOUT=<file.cpp> -P embed_examples.cmake
file(GLOB BINS "${SRC}/*.bin")
list(SORT BINS)
set(body "// generated by embed_examples.cmake - do not edit\n#include <cstddef>\n#include <cstdint>\n#include <cstring>\n#include <utility>\nnamespace lez {\n")
set(table "")
foreach(bin ${BINS})
  get_filename_component(name "${bin}" NAME_WE)
  file(READ "${bin}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR len "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "static const uint8_t k_${name}[${len}] = {${bytes}};\n")
  string(APPEND table "    if (std::strcmp(name, \"${name}\") == 0) return {k_${name}, ${len}};\n")
endforeach()
string(APPEND body "std::pair<const uint8_t*, size_t> exampleElf(const char* name) {\n${table}    return {nullptr, 0};\n}\n}  // namespace lez\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)

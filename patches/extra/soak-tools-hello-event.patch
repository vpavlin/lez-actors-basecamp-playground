diff --git a/examples/program_deployment/Cargo.toml b/examples/program_deployment/Cargo.toml
index bf20b3df..fb05678d 100644
--- a/examples/program_deployment/Cargo.toml
+++ b/examples/program_deployment/Cargo.toml
@@ -16,5 +16,5 @@ program_loader_core.workspace = true
 sequencer_service_rpc = { workspace = true, features = ["client"] }
 wallet.workspace = true
 
